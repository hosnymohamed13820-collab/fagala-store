# ===== الفجالة ستور =====
# أسرار — عمرها ما تتحط في git
config.php
config.php.*
local/config*.php
*_secret*
project_users.json
.env

# ملفات الوكلاء المحلية
*.state.json
*.lock
*.log

# رفع المستخدمين
**/uploads/*
!**/uploads/.htaccess

# مؤقتات
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# بايثون بتاع الاختبارات
__pycache__/
*.pyc
node_modules/

# نواتج الاختبارات المؤقتة
/tmp/

# نسخة المستودع المكسور — محلية بس
.git.broken/

# نسخة السيرفر المنزّلة — مرجع للمقارنة، مش شغل
public_html/

# مجلدات أدوات — مش شغل المشروع
.gemini/
.specify/
.claude/skills/speckit-*/
tests/__pycache__/

# نسخ القاعدة **بالبيانات** — فيها مرتبات وتليفونات وهاشات باسوردات.
# 🔴 حطّها في local/db/ وبس. local/ نفسه بيتعمله commit، فأي دَمب
#    بره المجلد ده بيدخل git من غير ما حد ياخد باله.
#    (local/schema_live.sql استثناء مقصود — بنية بس من غير بيانات.)
local/db/
*.sql.gz
*.sql.zip

# سجل الأخطاء — بيتكتب على السيرفر ويتنزّل مع الميرورينج (مش شغل)
site/logs/
logs/

# مخرجات المراجعة العميقة (بريف ١٨٢)
tests/audit/out/
